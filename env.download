# Local development environment. Gitignored (.gitignore excludes .env*).
# Never commit this file. See .env.example for the documented full list.

# ── Cloudflare Turnstile ──
# Widget created in the Cloudflare dashboard. Set BOTH or NEITHER:
# a site key without a secret renders a challenge nobody checks; a secret
# without a site key means no token is ever posted and every genuine enquiry
# is quarantined as spam. See src/lib/security/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAELhlldz5KmbQgFj
TURNSTILE_SECRET=0x4AAAAAAELhluNEgRxZah89si0pD1CV-ZY

