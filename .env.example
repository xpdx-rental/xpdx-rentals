# ─────────────────────────────────────────────────────────────────────────────
# XPDX Rentals — environment variables
# Copy to .env.local and fill in. Never commit real secrets (.env* is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (NEW project — create at supabase.com, then paste its keys here) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase (integration tests — `npm run test:rls` only) ──
# These can point at the same project as above, or a dedicated test project.
# Only used by src/lib/supabase/rls.integration.test.ts.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin bootstrap (comma-separated allowlist is a fallback; admin_roles table is primary) ──
ADMIN_EMAIL_ALLOWLIST=

# ── Geo restriction (edge middleware; see src/lib/security/geo-restriction.ts) ──
# The site is served only to the countries listed below. Enforced in
# middleware.ts from the CDN-injected country header, so it cannot be spoofed
# by a client. Leave everything unset for the default AU + IN policy.
#
# Kill switch — set to "false" to disable geo-restriction entirely.
GEO_RESTRICTION_ENABLED=
# Comma-separated ISO 3166-1 alpha-2 codes. Defaults to "AU,IN" when unset.
GEO_ALLOWED_COUNTRIES=
# Only set to "true" when self-hosting behind a geo-aware proxy that injects
# x-vercel-ip-country / cf-ipcountry / x-geo-country AND strips the client's own
# copy of it. On Vercel this is detected automatically — leave it unset there.
GEO_TRUST_PROXY_HEADERS=
# Non-production only: simulate a visitor country locally, e.g. GEO_DEV_COUNTRY=US
GEO_DEV_COUNTRY=

# ── Anti-spam ──
# A honeypot field plus a time-to-submit check run server-side and need no
# configuration. Thresholds live in src/lib/leads/spam-check.ts.
#
# Cloudflare Turnstile is the third signal, and it is OPTIONAL — both variables
# below are unset by default and the form behaves exactly as it did without it.
#
# Leave BOTH unset  → no widget renders, no third-party script loads, no
#                     verification happens. This is the correct setting for
#                     local, preview and any deployment not behind Cloudflare.
# Set BOTH          → the widget renders and the token is verified server-side
#                     against Cloudflare's siteverify endpoint.
#
# Do not set only one. A site key without a secret renders a challenge nobody
# checks; a secret without a site key means no token is ever posted and every
# genuine enquiry is quarantined as spam.
#
# A failed verification NEVER rejects an enquiry — the lead is still stored,
# flagged `spam`, and visible to staff. Cloudflare being unreachable fails open.
# See src/lib/security/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── Redis: distributed rate limiting AND the public read cache. ──
# One connection string serves both (src/lib/security/rate-limit-redis.ts and
# src/lib/redis.ts). Unset means per-instance in-memory rate limiting — which
# does NOT hold across serverless instances — and no read cache at all: every
# request queries Postgres directly. Correct, but slower and more expensive.
REDIS_URL=
# Salt for hashing lead IP addresses (never store raw IPs).
IP_HASH_SECRET=

# ── Transactional email: SMTP (nodemailer). No-ops if unset. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
REPLY_TO_EMAIL=
CONTACT_EMAIL_TO=

# ── Cron auth (lead anonymization / reminders) ──
CRON_SECRET=

# ── Analytics / SEO verification ──
# Google Tag Manager. Defaults to the client's existing container
# (GTM-M7BWGFK5) per CLAUDE.md §10. REBRAND.md §7 says confirm with the client
# whether to keep it or start a new one — never share a container between two
# clients. Set to an empty string to disable tagging entirely.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Social links (optional; rendered in footer) ──
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_X_URL=
