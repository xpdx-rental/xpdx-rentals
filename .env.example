# ─────────────────────────────────────────────────────────────────────────────
# XPDX Rentals — environment variables
# Copy to .env.local and fill in. Never commit real secrets (.env* is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (NEW project — create at supabase.com, then paste its keys here) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin bootstrap (comma-separated allowlist is a fallback; admin_roles is primary) ──
ADMIN_EMAIL=
ADMIN_EMAIL_ALLOWLIST=

# ── Geo restriction (edge middleware; see src/lib/security/geo-restriction.ts) ──
# The site is served only to the countries listed below. Enforced in
# middleware.ts from the CDN-injected country header, so it cannot be spoofed
# by a client. Leave everything unset for the default AU + IN policy.
#
# Kill switch — set to "false" to disable geo-restriction entirely.
GEO_RESTRICTION_ENABLED=
# Comma-separated ISO 3166-1 alpha-2 codes. Defaults to "AU,IN" when unset.
GEO_ALLOWED_COUNTRIES=
# Only set to "true" when self-hosting behind a geo-aware proxy that injects
# x-vercel-ip-country / cf-ipcountry / x-geo-country AND strips the client's own
# copy of it. On Vercel this is detected automatically — leave it unset there.
GEO_TRUST_PROXY_HEADERS=
# Non-production only: simulate a visitor country locally, e.g. GEO_DEV_COUNTRY=US
GEO_DEV_COUNTRY=

# ── Anti-spam ──
# There is no CAPTCHA. CLAUDE.md §9: "Honeypot field plus a timing check. No
# CAPTCHA unless spam actually appears — it costs conversions." Both are
# server-side and need no configuration. If spam does appear, the honeypot and
# timing thresholds are in src/lib/leads/spam-check.ts.

# ── Rate limiting: Redis (Upstash-compatible). Falls back to in-memory if unset. ──
REDIS_URL=
# Salt for hashing lead IP addresses (never store raw IPs).
IP_HASH_SECRET=

# ── Transactional email: SMTP (nodemailer). No-ops if unset. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
REPLY_TO_EMAIL=
CONTACT_EMAIL_TO=

# ── Cron auth (lead anonymization / reminders) ──
CRON_SECRET=

# ── Analytics / SEO verification ──
# Google Tag Manager. Defaults to the client's existing container
# (GTM-M7BWGFK5) per CLAUDE.md §10. REBRAND.md §7 says confirm with the client
# whether to keep it or start a new one — never share a container between two
# clients. Set to an empty string to disable tagging entirely.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Social links (optional; rendered in footer) ──
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_X_URL=
